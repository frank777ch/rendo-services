# ==========================================================================
# SEDAPAL - Agua (oficina virtual Aquanet / SOCV)
# ==========================================================================
# URL de la oficina virtual Aquanet (SOCV) de Sedapal
AQUANET_LOGIN_URL=https://webapp16.sedapal.com.pe/socv/#/iniciar-sesion
# Correo y contraseña con los que te registraste en Aquanet
SEDAPAL_USER=tu-correo@ejemplo.com
SEDAPAL_PASS=tu-contrasena
# Número de suministro (NIS), 7 dígitos
SUMINISTRO=1234567

# ==========================================================================
# CALIDDA - Gas natural (oficina virtual)
# ==========================================================================
# URL de registro / login de la oficina virtual de Cálidda
CALIDDA_LOGIN_URL=https://appadmin.calidda.com.pe/frontov/usuario
# Correo y contraseña de tu cuenta de Cálidda (una cuenta sirve para varios suministros)
CALIDDA_USER=tu-correo@gmail.com
CALIDDA_PASS=tu-contrasena
# Códigos de cliente (número de cliente) a consultar, separados por coma. Sin ceros a la izquierda.
CALIDDA_CLIENTES=1234567,2345678

# ==========================================================================
# LUZ DEL SUR - Electricidad
# ==========================================================================
# Base del sitio (ajax JSON de la web pública/oficina virtual)
LUZDELSUR_BASE_URL=https://www.luzdelsur.pe/es
# Correo y contraseña de tu cuenta de Luz del Sur (para el historial completo)
LUZDELSUR_USER=tu-correo@ejemplo.com
LUZDELSUR_PASS=tu-contrasena
# Números de suministro a consultar, separados por coma
LUZDELSUR_SUMINISTROS=1234567

# ==========================================================================
# API (tu servicio)
# ==========================================================================
# Token bearer que protege tu API. Genera uno largo y secreto.
API_TOKEN=pon-un-token-secreto-largo-aqui
API_HOST=0.0.0.0
API_PORT=8000
